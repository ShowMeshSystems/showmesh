# Environment file for the ShowMesh coordinator appliance bundle.
# Copy to .env in this directory (deploy/.env) and adjust as needed:
#   cp .env.example .env
#
# Secrets (MQTT username/password, any future API tokens) belong ONLY in
# this file, which docker-compose.yml loads via env_file and which must
# stay out of version control. Never place secrets in exported
# configuration bundles: ARCHITECTURE.md section 10.4 requires that
# portable configuration exports exclude secrets by default, and
# ADR-009 says the same for YAML export bundles.

# --- Coordinator HTTP -------------------------------------------------
# Address the coordinator's HTTP server (health, readiness, version, and
# eventually the dashboard) binds to inside the container.
# SHOWMESH_HTTP_ADDR=:8080

# Host port published for the coordinator HTTP server.
# SHOWMESH_HTTP_PORT=8080

# --- MQTT control plane (ADR-008) --------------------------------------
# Broker URL the coordinator connects to. Defaults to the bundled
# mosquitto service. Point this at an external broker instead by setting
# it to that broker's address, e.g. tcp://broker.example.lan:1883, and
# optionally removing the mosquitto service from docker-compose.yml.
# SHOWMESH_MQTT_BROKER=tcp://mosquitto:1883

# Client ID the coordinator presents to the broker.
# SHOWMESH_MQTT_CLIENT_ID=showmesh-coordinator

# Credentials for the broker, only needed once mosquitto.conf has
# allow_anonymous disabled and a password_file configured (see the
# comment block at the top of deploy/mosquitto/mosquitto.conf).
# SHOWMESH_MQTT_USERNAME=
# SHOWMESH_MQTT_PASSWORD=

# Host port published for the bundled Mosquitto broker.
# MOSQUITTO_PORT=1883

# --- Read-only control API (ADR-014, ADR-020, ADR-021) ------------------
# The coordinator serves a versioned, public, read-only API at /api/v1 on
# the same HTTP port as the health endpoints, plus a Server-Sent Events
# change stream at /api/v1/stream. It is a documented contract usable
# without any UI: see api/openapi.yaml in the repository, or try
#   curl -s localhost:8080/api/v1/nodes
#   curl -N  localhost:8080/api/v1/stream
#
# Optional shared secret. When set, every /api/v1 request, including the
# change stream, must carry "Authorization: Bearer <token>". When unset
# the API is OPEN to anyone who can reach this port, and the coordinator
# logs a warning saying so at startup.
#
# READ ADR-021 BEFORE RELYING ON THIS. It is one shared secret with no
# identity, no roles, and no audit attribution, so it does not satisfy
# ARCHITECTURE section 10.4. The show VLAN is still the actual security
# boundary; this is a switch for operators who want the API closed, not a
# substitute for network isolation.
# SHOWMESH_API_TOKEN=

# Comma-separated list of browser origins allowed to call the API
# cross-origin. Empty (the default) emits no CORS headers at all, which
# is correct until an Operator UI exists and is served from a different
# origin. Arbitrary origins are never reflected.
# SHOWMESH_API_ALLOWED_ORIGINS=

# --- FPP observability (ADR-001, ADR-011) -------------------------------
# Comma-separated id=url pairs naming the FPP instances the coordinator
# polls read-only over REST, e.g.
#   SHOWMESH_FPP_ENDPOINTS=player-01=http://10.0.1.20,shed=http://10.0.1.21
# IDs follow the same syntax as node IDs. A malformed entry is a startup
# error rather than a silently skipped endpoint, because an FPP that is
# invisible with no complaint is how you come to trust a dashboard that
# is watching nothing.
#
# Empty (the default) means the collector does not run. That is reported
# through the API as "not collected", never as an absence: ShowMesh
# distinguishes "no FPP is configured" from "an FPP was polled and
# failed". ShowMesh only ever issues GET requests to FPP and never
# commands it; FPP remains the authoritative scheduler per ADR-001.
# SHOWMESH_FPP_ENDPOINTS=

# --- Storage (ADR-009) --------------------------------------------------
# Path inside the container where the coordinator keeps its SQLite
# database and other state. Matches the named volume mount point in
# docker-compose.yml; only change this if you also change that mount.
# SHOWMESH_DATA_DIR=/var/lib/showmesh

# --- Logging -------------------------------------------------------------
# One of: debug, info, warn, error.
# SHOWMESH_LOG_LEVEL=info

# --- Image build metadata -------------------------------------------------
# Only used when docker-compose.yml builds the image locally (the
# `build:` block). Ignored if you switch to the commented `image:` line
# once published images exist.
# SHOWMESH_VERSION=dev
# SHOWMESH_COMMIT=none
# SHOWMESH_BUILD_DATE=unknown
