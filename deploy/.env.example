# Environment file for the ShowMesh coordinator appliance bundle.
# Copy to .env in this directory (deploy/.env) and adjust as needed:
#   cp .env.example .env
#
# Secrets (MQTT username/password, any future API tokens) belong ONLY in
# this file, which docker-compose.yml loads via env_file and which must
# stay out of version control. Never place secrets in exported
# configuration bundles: ARCHITECTURE.md section 10.4 requires that
# portable configuration exports exclude secrets by default, and
# ADR-009 says the same for YAML export bundles.

# --- Coordinator HTTP -------------------------------------------------
# Address the coordinator's HTTP server (health, readiness, version, and
# eventually the dashboard) binds to inside the container.
# SHOWMESH_HTTP_ADDR=:8080

# Host port published for the coordinator HTTP server.
# SHOWMESH_HTTP_PORT=8080

# --- MQTT control plane (ADR-008, ADR-024 decision 10) -------------------
# Broker URL the coordinator connects to. Defaults to the bundled
# mosquitto service. Point this at an external broker instead by setting
# it to that broker's address, e.g. tcp://broker.example.lan:1883, and
# optionally removing the mosquitto service from docker-compose.yml.
# SHOWMESH_MQTT_BROKER=tcp://mosquitto:1883

# Client ID the coordinator presents to the broker.
# SHOWMESH_MQTT_CLIENT_ID=showmesh-coordinator

# Broker credentials for the coordinator. REQUIRED for the bundled broker:
# mosquitto.conf sets allow_anonymous false, so the coordinator cannot
# connect at all without these. Do not set these by hand — run, once,
# from this directory:
#
#   ./mosquitto/generate-credentials.sh
#
# It generates a random per-deployment coordinator credential (and the
# healthcheck credential below) and writes both directly into THIS FILE
# (deploy/.env), upserting these two lines. See deploy/README.md's "MQTT
# broker credentials" section and deploy/mosquitto/acl.conf's header
# comment for the full picture, including the FPP publisher role and how
# to provision a credential for each ShowMesh agent (node).
# SHOWMESH_MQTT_USERNAME=
# SHOWMESH_MQTT_PASSWORD=

# Credentials the bundled broker's own container healthcheck uses (a
# dedicated principal with read-only access to $SYS, per
# deploy/mosquitto/acl.conf). Also written by generate-credentials.sh; you
# should not need to set these by hand.
# MOSQUITTO_HEALTHCHECK_USERNAME=
# MOSQUITTO_HEALTHCHECK_PASSWORD=

# Host port published for the bundled Mosquitto broker.
# MOSQUITTO_PORT=1883

# --- Control API (ADR-014, ADR-020, ADR-024) ----------------------------
# The coordinator serves a versioned, public API at /api/v1 on the same
# HTTP port as the health endpoints, plus a Server-Sent Events change
# stream at /api/v1/stream. It is a documented contract usable without any
# UI: see api/openapi.yaml in the repository, or try
#   curl -s localhost:8080/api/v1/nodes
#   curl -N  localhost:8080/api/v1/stream
#
# UPGRADING: SHOWMESH_API_TOKEN IS RETIRED AND MUST BE REMOVED.
# ADR-024 replaced the shared secret with real principals. A coordinator
# that still sees SHOWMESH_API_TOKEN set REFUSES TO START and names the
# migration in the error. That is deliberate: ignoring it would silently
# reopen a read API you had deliberately closed, on a container tag change
# alone. Delete the variable, then use SHOWMESH_API_CLOSE_READS below.
#
# Reads are open by default; writes always require an authenticated
# principal and cannot be opened. Set this to close reads too, requiring a
# principal holding the read scopes. Weigh it honestly: closing reads means
# a credential problem costs you visibility of a running show, which is
# why the default is open (ADR-024 decision 2).
# SHOWMESH_API_CLOSE_READS=false
#
# Create your first administrator from the one-time bootstrap code the
# coordinator writes to its data volume on first run (never to a log):
#   POST /api/v1/bootstrap, or
#   docker compose exec coordinator showmesh-coordinator bootstrap
# Machine credentials for showmeshctl and automation:
#   docker compose exec coordinator showmesh-coordinator issue-token ...
# The CLI reads its token from SHOWMESH_CTL_TOKEN, deliberately NOT
# SHOWMESH_API_TOKEN, whose presence now blocks coordinator startup.
#
# Set true when a reverse proxy terminates TLS in front of this bundle, so
# the session cookie carries the Secure attribute. It is never inferred
# from X-Forwarded-Proto: trusting a forwarded header would make the proxy
# part of the trust decision (ADR-024 decision 5).
# SHOWMESH_API_SECURE_COOKIE=false

# Comma-separated list of browser origins allowed to call the API
# cross-origin. Empty (the default) emits no CORS headers at all. The
# bundled Operator UI (see the "Operator UI" section below) never needs an
# entry here: ADR-022 makes it a same-origin proxy in front of this API,
# not a separate origin calling in. This setting is for a browser client
# that addresses the coordinator directly instead.
# SHOWMESH_API_ALLOWED_ORIGINS=

# --- Operator UI (ADR-014, ADR-015, ADR-022) -----------------------------
# The Operator UI is a separate, optional container (the `ui` service)
# serving the built TypeScript SPA and proxying /api/* to the coordinator
# above so the browser sees one origin. Point a browser at
#   http://localhost:${SHOWMESH_UI_PORT:-8081}
# The coordinator itself is unaffected by whether this container runs at
# all, is stopped, or is removed entirely (ADR-014's governing test).
#
# Host port published for the Operator UI container.
# SHOWMESH_UI_PORT=8081
#
# Host and container-internal port of the coordinator the UI's nginx
# proxies to. Defaults to this bundle's own coordinator service and its
# container-internal port (not SHOWMESH_HTTP_PORT above, which is the
# *host*-side mapping); change these only to point the UI at a coordinator
# outside this bundle.
# SHOWMESH_COORDINATOR_HOST=coordinator
# SHOWMESH_COORDINATOR_PORT=8080
#
# There is deliberately no credential entry for the ui service, and none
# should ever be added here. ADR-022 decision 2: the UI container must
# never hold, inject, or be configured with a credential of its own,
# because a proxy holding one makes reaching the UI equivalent to reaching
# the API. The browser signs in against the coordinator and holds the
# HttpOnly session cookie the coordinator mints; this proxy only forwards
# Cookie and Set-Cookie unchanged.

# --- FPP observability (ADR-001, ADR-011) -------------------------------
# SHOWMESH_FPP_ENDPOINTS is a ONE-TIME BOOTSTRAP for a NEW deployment
# ONLY (RES-008 D1). It is not the ongoing way to configure which FPP
# hosts this coordinator polls — that is
# PUT /api/v1/config/fpp.endpoints (Step 7 seam A: Configuration in the
# Operator UI, or `showmeshctl config set`), which keeps a revision
# history in this coordinator's own store. Comma-separated id=url pairs,
# e.g.
#   SHOWMESH_FPP_ENDPOINTS=player-01=http://10.0.1.20,shed=http://10.0.1.21
# IDs follow the same syntax as node IDs. A malformed entry is a startup
# error rather than a silently skipped endpoint, because an FPP that is
# invisible with no complaint is how you come to trust a dashboard that
# is watching nothing.
#
# On a coordinator's FIRST boot with this set, the list is migrated into
# the store as revision 1 and this coordinator logs a warning that the
# store is now authoritative and the variable may be removed. LEAVE IT SET
# past that point ONLY if you never intend to change the endpoint list
# through the API/UI/CLI again: once the store is authoritative, this
# variable is compared against it on every later boot, and a coordinator
# whose store disagrees with a still-set SHOWMESH_FPP_ENDPOINTS REFUSES TO
# START, naming the difference — this is deliberate (RES-008 D1: a config
# change made through the sanctioned surface must never be silently
# overridden by a stale environment file at the next restart). Remove this
# variable once the store has taken over. A write through the API/UI/CLI
# is ALSO refused outright (409) for as long as this variable is still
# set, for the identical reason, so the write itself tells you to remove
# it before it lets you make the change at all.
#
# Empty (the default) means the collector does not run, until configured
# through PUT /api/v1/config/fpp.endpoints. That is reported through the
# API as "not collected", never as an absence: ShowMesh distinguishes "no
# FPP is configured" from "an FPP was polled and failed". ShowMesh only
# ever issues GET requests to FPP and never commands it; FPP remains the
# authoritative scheduler per ADR-001.
# SHOWMESH_FPP_ENDPOINTS=

# --- Storage (ADR-009) --------------------------------------------------
# Path inside the container where the coordinator keeps its SQLite
# database and other state. Matches the named volume mount point in
# docker-compose.yml; only change this if you also change that mount.
# SHOWMESH_DATA_DIR=/var/lib/showmesh

# --- Logging -------------------------------------------------------------
# One of: debug, info, warn, error.
# SHOWMESH_LOG_LEVEL=info

# --- Image build metadata -------------------------------------------------
# Only used when docker-compose.yml builds the image locally (the
# `build:` block). Ignored if you switch to the commented `image:` line
# once published images exist.
# SHOWMESH_VERSION=dev
# SHOWMESH_COMMIT=none
# SHOWMESH_BUILD_DATE=unknown
