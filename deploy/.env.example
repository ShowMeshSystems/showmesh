# Environment file for the ShowMesh coordinator appliance bundle.
# Copy to .env in this directory (deploy/.env) and adjust as needed:
#   cp .env.example .env
#
# Secrets (MQTT username/password, any future API tokens) belong ONLY in
# this file, which docker-compose.yml loads via env_file and which must
# stay out of version control. Never place secrets in exported
# configuration bundles: ARCHITECTURE.md section 10.4 requires that
# portable configuration exports exclude secrets by default, and
# ADR-009 says the same for YAML export bundles.

# --- Coordinator HTTP -------------------------------------------------
# Address the coordinator's HTTP server (health, readiness, version, and
# eventually the dashboard) binds to inside the container.
# SHOWMESH_HTTP_ADDR=:8080

# Host port published for the coordinator HTTP server.
# SHOWMESH_HTTP_PORT=8080

# --- MQTT control plane (ADR-008) --------------------------------------
# Broker URL the coordinator connects to. Defaults to the bundled
# mosquitto service. Point this at an external broker instead by setting
# it to that broker's address, e.g. tcp://broker.example.lan:1883, and
# optionally removing the mosquitto service from docker-compose.yml.
# SHOWMESH_MQTT_BROKER=tcp://mosquitto:1883

# Client ID the coordinator presents to the broker.
# SHOWMESH_MQTT_CLIENT_ID=showmesh-coordinator

# Credentials for the broker, only needed once mosquitto.conf has
# allow_anonymous disabled and a password_file configured (see the
# comment block at the top of deploy/mosquitto/mosquitto.conf).
# SHOWMESH_MQTT_USERNAME=
# SHOWMESH_MQTT_PASSWORD=

# Host port published for the bundled Mosquitto broker.
# MOSQUITTO_PORT=1883

# --- Storage (ADR-009) --------------------------------------------------
# Path inside the container where the coordinator keeps its SQLite
# database and other state. Matches the named volume mount point in
# docker-compose.yml; only change this if you also change that mount.
# SHOWMESH_DATA_DIR=/var/lib/showmesh

# --- Logging -------------------------------------------------------------
# One of: debug, info, warn, error.
# SHOWMESH_LOG_LEVEL=info

# --- Image build metadata -------------------------------------------------
# Only used when docker-compose.yml builds the image locally (the
# `build:` block). Ignored if you switch to the commented `image:` line
# once published images exist.
# SHOWMESH_VERSION=dev
# SHOWMESH_COMMIT=none
# SHOWMESH_BUILD_DATE=unknown
