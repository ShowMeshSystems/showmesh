# Grants group read access to any PTP hardware clock so the ShowMesh
# agent and the headless PipeWire graph -- both run as the showmesh user,
# see install-ptp-audio.sh -- can open /dev/ptpN: the agent's external
# clock provider reads the PHC directly via clock_gettime(FD_TO_CLOCKID),
# and PipeWire's PTP node.driver opens it read-only for the same reason
# (RES-019 sections 4.5 and 5.1). Matches on subsystem rather than a
# specific ptpN name, so it keeps working if the index changes (a second
# NIC, a reboot after a driver change).
SUBSYSTEM=="ptp", GROUP="showmesh", MODE="0640"
