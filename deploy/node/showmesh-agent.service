# ShowMesh node agent systemd unit. Installed by install.sh to
# /etc/systemd/system/showmesh-agent.service.
#
# Hardening notes (read before adding a directive back):
#
# ProtectHome, PrivateDevices, and a DeviceAllow allowlist are deliberately
# NOT set here. The agent's GStreamer pipeline needs real access to ALSA
# device nodes under /dev/snd (and, on a render node, to the GPU/DRM
# devices GStreamer's video sinks open), and systemd's device-isolation
# directives are known to interact badly with both: PrivateDevices=true
# hides /dev/snd entirely, and an incomplete DeviceAllow list produces a
# silent "no such device" failure inside GStreamer rather than a unit
# start failure systemd would surface. Nothing in this install flow can
# verify the correct DeviceAllow list against a real audio interface
# (that is per-hardware commissioning, out of scope here, see
# deploy/node/README.md), so an unverified guess is left out rather than
# shipped as if it were tested.
[Unit]
Description=ShowMesh node agent
Documentation=https://github.com/ShowMeshSystems/showmesh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=showmesh
Group=showmesh
EnvironmentFile=/etc/showmesh/agent.env
ExecStart=/usr/local/bin/showmesh-agent-native
WorkingDirectory=/var/lib/showmesh
StateDirectory=showmesh
StateDirectoryMode=0750
Restart=on-failure
RestartSec=2s

# Raspberry Pi hosts (the expected audio node hardware) default to a 1024
# file-descriptor limit. This unit sets an explicit margin above that
# default rather than inheriting it; it is defense in depth, not a fix for
# any descriptor leak the agent itself may have.
LimitNOFILE=65536

# Grants the one privilege the agent's FPP Connect HTTP compatibility
# listener needs to bind port 80 (ADR-044 decision 5): xLights hardcodes
# port 80 in both the discovery and upload URLs it builds, so moving the
# bind elsewhere would make the node unreachable rather than solve
# anything. A node running without this capability fails to bind and
# reports the bind failure as evidence; it never falls back to a port
# xLights will never contact.
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Conservative process-level hardening that does not touch device access.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/showmesh
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
