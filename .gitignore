bin/
dist/
# Stray cross-compile output. `make build` writes to bin/, but an ad-hoc
# `GOOS=windows go build ./...` drops binaries in the package directory.
*.exe
# Same failure mode, no extension: an ad-hoc `go build -o showmeshctl
# ./cmd/showmeshctl` (or the coordinator/agent/probe equivalents) run from
# the repo root, rather than through `make build` into bin/, leaves a
# stray executable at the repo root with no extension for *.exe to catch.
# Found as an untracked stray binary during Step 3's wiring pass.
/showmeshctl
/showmesh-coordinator
/showmesh-agent
/showmesh-multisync-probe
*.db
*.db-wal
*.db-shm
.DS_Store
.env
coverage.out

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# Local working notes, not for the repo
docs/private/

# Operator UI (ui/). package-lock.json is committed; node_modules and the
# Vite build output (dist/, already covered above) are not.
ui/node_modules/
ui/.vite/
