bin/
dist/
# Stray cross-compile output. `make build` writes to bin/, but an ad-hoc
# `GOOS=windows go build ./...` drops binaries in the package directory.
*.exe
# Same failure mode, no extension: an ad-hoc `go build -o showmeshctl
# ./cmd/showmeshctl` (or the coordinator/agent/probe equivalents) run from
# the repo root, rather than through `make build` into bin/, leaves a
# stray executable at the repo root with no extension for *.exe to catch.
# Found as an untracked stray binary during Step 3's wiring pass.
/showmeshctl
/showmesh-coordinator
/showmesh-agent
/showmesh-multisync-probe
*.db
*.db-wal
*.db-shm
.DS_Store
.env
coverage.out

# Generated per-deployment MQTT broker credentials (ADR-024 decision 10):
# deploy/mosquitto/generate-credentials.sh and
# deploy/mosquitto/add-agent-credential.sh write this file. It must never
# be committed — a passwd file checked into the repo would be identical in
# every ShowMesh installation, exactly the failure ADR-021 named when it
# rejected a mandatory shared secret with no distribution mechanism.
deploy/mosquitto/passwd

# Effective MQTT ACL generated from acl.conf and the non-fixed usernames in
# passwd. Kept out of version control so agents can be provisioned and
# retired without making the deployment checkout dirty.
deploy/mosquitto/acl.generated.conf
deploy/mosquitto/.acl-explicit-agents-v1

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# Local working notes, not for the repo
docs/private/

# Operator UI (ui/). package-lock.json is committed; node_modules and the
# Vite build output (dist/, already covered above) are not.
ui/node_modules/
ui/.vite/
