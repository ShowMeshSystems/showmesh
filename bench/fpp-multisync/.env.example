# Copy to .env and adjust. Every setting here has a working default (see
# docker-compose.yml), so an empty/absent .env is also fine to start with.

# FPP version to build, as an explicit git tag in FalconChristmas/fpp (never
# a floating branch -- see README.md "Versions" for why, and for the tags
# this repo has confirmed exist upstream).
#
# This bench's two selectable targets, both confirmed directly against
# upstream (`git ls-remote https://github.com/FalconChristmas/fpp.git
# 'refs/tags/<tag>^{}'`), see README.md "Versions" for the full table:
#   FPP_GIT_REF=9.5.3 # 9.5 stable line (default), commit 7979a4bb0bb9068fea71f3b447e273d5c0ea01e3
#   FPP_GIT_REF=10.0  # 10.0 line, commit 370e62ed7e8c8318da6ee5b01312b8b75082d952
FPP_GIT_REF=9.5.3

# Host port for fpp-master's web UI (container's port 80).
FPP_MASTER_HTTP_PORT=8090

# Host port for fpp-remote's web UI (profile: remote; container's port 80).
FPP_REMOTE_HTTP_PORT=8091

# Host directory captures land in. A relative path is resolved against this
# directory (bench/fpp-multisync), same as docker compose's own default
# behavior for relative bind-mount paths.
CAPTURES_DIR=./captures

# ShowMesh probe image build metadata, same convention as deploy/.env.example.
SHOWMESH_VERSION=dev
SHOWMESH_COMMIT=none
SHOWMESH_BUILD_DATE=unknown
